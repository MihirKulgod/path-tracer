{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug (GCC, sanitizers)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS_DEBUG": "-Og -g",
        "PATHTRACER_SANITIZE": "ON"
      }
    },
    {
      "name": "debug-clang",
      "displayName": "Debug (Clang, sanitizers)",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "_comment": "Clang defaults to the newest GCC toolchain dir (14), which has no libstdc++.so installed. Pin it to 13 so both compilers share one standard library.",
        "CMAKE_CXX_FLAGS": "--gcc-install-dir=/usr/lib/gcc/x86_64-linux-gnu/13"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo (profiling, timing runs)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -fno-omit-frame-pointer"
      }
    },
    {
      "name": "release",
      "displayName": "Release (final renders)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -march=native"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "debug-clang", "configurePreset": "debug-clang" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
    { "name": "release", "configurePreset": "release" }
  ]
}
